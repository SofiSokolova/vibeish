# Copy this file to .env and fill in the values from your Supabase project's API settings.
# Both values are public by design (they ship inside the app). Never put secret keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# For the local Supabase (npm run db:start), put the same two names with the API URL and the
# publishable key that `npx supabase status` prints into .env.development.local:
# `npx expo start` reads it before .env, and builds don't.
